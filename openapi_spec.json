{
  "openapi": "3.1.0",
  "info": {
    "title": "Tisdale QTc Risk Score API",
    "description": "Deterministic clinical scoring plus legacy local demonstration endpoints. Refer to /openapi.json for the runtime-generated API schema.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Process counters (JSON)",
        "responses": {
          "200": {
            "description": "Process metrics"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Calculate validated Tisdale risk score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age",
                  "sex",
                  "loop_diuretic",
                  "potassium",
                  "qtc",
                  "acute_mi",
                  "heart_failure",
                  "num_qtdrugs",
                  "sepsis"
                ],
                "properties": {
                  "age": {
                    "type": "number"
                  },
                  "sex": {
                    "type": "string"
                  },
                  "loop_diuretic": {
                    "type": "boolean"
                  },
                  "potassium": {
                    "type": "number"
                  },
                  "qtc": {
                    "type": "number"
                  },
                  "acute_mi": {
                    "type": "boolean"
                  },
                  "heart_failure": {
                    "type": "boolean"
                  },
                  "num_qtdrugs": {
                    "type": "integer"
                  },
                  "sepsis": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score, risk tier, point breakdown and completeness"
          },
          "422": {
            "description": "Invalid clinical input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic demonstration audit (not clinical scoring)",
        "responses": {
          "200": {
            "description": "In-memory demonstration dossier"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Legacy in-memory audit log",
        "responses": {
          "200": {
            "description": "In-memory signatures and verification status"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Offline mock response (no model inference)",
        "responses": {
          "200": {
            "description": "Demonstration response"
          }
        }
      }
    }
  }
}
